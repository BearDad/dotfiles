{
  "show-keybinds": true,
  "css": "/home/kuma/.config/wleave/style.css",
  "buttons": [
    {
      "label": "lock",
      "action": "systemd-run --user hyprlock",
      "text": "Lock",
      "keybind": "l",
      "icon": "/usr/share/wleave/icons/lock.svg"
    },
    {
      "label": "logout",
      "action": "hyprctl dispatch exit 0",
      "text": "Logout",
      "keybind": "e",
      "icon": "/usr/share/wleave/icons/logout.svg"
    },
    {
      "label": "shutdown",
      "action": "systemctl poweroff",
      "text": "Shutdown",
      "keybind": "s",
      "icon": "/usr/share/wleave/icons/shutdown.svg"
    },
    {
      "label": "reboot",
      "action": "systemctl reboot",
      "text": "Reboot",
      "keybind": "r",
      "icon": "/usr/share/wleave/icons/reboot.svg"
    }
  ]
}
